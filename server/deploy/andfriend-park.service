[Unit]
Description=And Friend - The Park WebSocket Relay Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/andfriend-park
ExecStart=/opt/andfriend-park/server
Restart=always
RestartSec=5s
Environment=PORT=8080
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
